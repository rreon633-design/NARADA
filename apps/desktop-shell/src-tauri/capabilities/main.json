{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Bundled owner window: explicit metadata, pairing, registered-root file controls and one native folder picker. No unrestricted filesystem, shell or remote admin forwarding.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-get-snapshot",
    "allow-save-settings",
    "allow-run-diagnostics",
    "allow-clear-activity",
    "allow-configure-connections",
    "allow-cancel-pairing",
    "allow-approve-pairing",
    "allow-reject-pairing",
    "allow-join-pairing",
    "allow-cancel-join",
    "allow-update-peer-permissions",
    "allow-revoke-peer",
    "allow-reconnect-peer",
    "allow-set-peer-endpoint",
    "allow-start-pairing",
    "allow-discover-peers",
    "allow-list-roots",
    "allow-register-root",
    "allow-update-root-policy",
    "allow-remove-root",
    "allow-reindex-root",
    "allow-file-query",
    "allow-file-mutation",
    "allow-remote-file-query",
    "allow-remote-file-mutation",
    "allow-choose-root",
    "allow-list-transfers",
    "allow-start-transfer",
    "allow-transfer-control",
    "allow-create-transfer-offer",
    "allow-poll-transfer-offers",
    "allow-accept-transfer-offer",
    "allow-cleanup-transfers",
    "allow-content-status",
    "allow-list-conversations",
    "allow-chat-history",
    "allow-send-chat",
    "allow-save-chat-draft",
    "allow-mark-chat-read",
    "allow-chat-control",
    "allow-fetch-attachment",
    "allow-pause-attachment",
    "allow-export-attachment",
    "allow-cleanup-content",
    "allow-sync-query",
    "allow-list-pins",
    "allow-create-pin",
    "allow-pin-control",
    "allow-refresh-sync",
    "allow-support-bundle"
  ]
}
