{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NARADA",
  "version": "0.7.1",
  "identifier": "com.narada.desktop.dev",
  "build": {
    "beforeDevCommand": "npm --prefix ../../desktop-ui run dev:native",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix ../../desktop-ui run build",
    "frontendDist": "../../../desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NARADA",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#F6F6F4",
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": [
        "main"
      ],
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "externalBin": [
      "binaries/narada-agent"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
